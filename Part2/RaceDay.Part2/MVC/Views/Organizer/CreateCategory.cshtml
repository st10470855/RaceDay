@model MVC.ViewModels.CreateOrganizerCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-3">Create Event Category</h2>
                    <p class="text-muted">Add a category to your event.</p>

                    <form asp-action="CreateCategory" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="EventID" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CategoryName"
                                   class="form-label">Category Name</label>
                            <input asp-for="CategoryName"
                                   class="form-control"
                                   placeholder="e.g. Junior 5 km" />
                            <span asp-validation-for="CategoryName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label">Description</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MinAge"
                                       class="form-label">Minimum Age</label>
                                <input asp-for="MinAge"
                                       type="number"
                                       class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxAge"
                                       class="form-label">Maximum Age</label>
                                <input asp-for="MaxAge"
                                       type="number"
                                       class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MinDistance"
                                       class="form-label">Minimum Distance (km)</label>
                                <input asp-for="MinDistance"
                                       type="number"
                                       step="0.1"
                                       class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxDistance"
                                       class="form-label">Maximum Distance (km)</label>
                                <input asp-for="MaxDistance"
                                       type="number"
                                       step="0.1"
                                       class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SortOrder"
                                   class="form-label">Display Order</label>
                            <input asp-for="SortOrder"
                                   type="number"
                                   class="form-control"
                                   value="0" />
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">
                            Create Category
                        </button>

                        <a asp-action="Categories"
                           asp-route-eventId="@Model.EventID"
                           class="btn btn-outline-secondary w-100 mt-2">
                            Cancel
                        </a>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>