@model MVC.ViewModels.CreateOrganizerEventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold text-primary">Create a New Event</h1>
        <p class="text-muted">
            Enter the details of your running, walking or cycling event.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Organizer"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label fw-bold">
                        Event Name
                    </label>
                    <input asp-for="EventName" class="form-control"
                           placeholder="e.g. Johannesburg City Run" />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">
                        Description
                    </label>
                    <textarea asp-for="Description" class="form-control"
                              rows="3" placeholder="Describe your event"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label fw-bold">
                        Event Date
                    </label>
                    <input asp-for="EventDate" type="date" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label fw-bold">
                        Location
                    </label>
                    <input asp-for="Location" class="form-control"
                           placeholder="e.g. Johannesburg, Gauteng" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Distance" class="form-label fw-bold">
                        Distance (km)
                    </label>
                    <input asp-for="Distance" type="number" step="0.1"
                           min="0.1" max="500" class="form-control"
                           placeholder="e.g. 10" />
                    <span asp-validation-for="Distance" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventType" class="form-label fw-bold">
                        Event Type
                    </label>
                    <select asp-for="EventType" class="form-select">
                        <option value="">-- Select event type --</option>
                        <option value="Run">Running</option>
                        <option value="Walk">Walking</option>
                        <option value="Cycle">Cycling</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="BannerImage" class="form-label fw-bold">
                        Event Banner Image (Optional)
                    </label>
                    <input asp-for="BannerImage"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp"
                           class="form-control" />
                    <small class="text-muted">
                        Allowed formats: JPG, JPEG, PNG and WEBP.
                    </small>
                    <span asp-validation-for="BannerImage" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Event
                </button>

                <a asp-controller="Organizer"
                   asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
