@model List<MVC.ViewModels.OrganizerEnrolmentViewModel>

@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Event Enrolments</h2>
            <p class="text-muted">
                Participants registered for this event.
            </p>
        </div>

        <a asp-controller="Organizer"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Enrolment Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var enrolment in Model)
                        {
                            <tr>
                                <td>@enrolment.ParticipantName</td>

                                <td>@enrolment.CategoryName</td>

                                <td>
                                    @enrolment.EnrolmentDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        @enrolment.Status
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="Organizer"
                                       asp-action="RecordResult"
                                       asp-route-enrolmentId="@enrolment.EnrolmentID"
                                       asp-route-eventId="@ViewBag.EventID"
                                       asp-route-participantName="@enrolment.ParticipantName"
                                       class="btn btn-sm btn-outline-primary">
                                        Record Result
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }

</div>
