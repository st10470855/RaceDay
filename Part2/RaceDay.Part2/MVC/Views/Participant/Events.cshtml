@model List<MVC.ViewModels.ParticipantEventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold text-primary">Browse Events</h1>
        <p class="text-muted">
            Discover upcoming running, walking and cycling events.
        </p>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
            Please check again later.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body p-4">

                            <span class="badge bg-primary mb-3">
                                @eventItem.EventType
                            </span>

                            <h4 class="fw-bold">
                                @eventItem.EventName
                            </h4>

                            <p class="text-muted">
                                @eventItem.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @eventItem.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @eventItem.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @eventItem.Distance km
                            </p>
                            <a asp-controller="Participant"
                               asp-action="Enrol"
                               asp-route-id="@eventItem.EventID"
                               class="btn btn-primary w-100 mt-3">
                                Enrol Now
                            </a>

                        </div>

                    </div>
                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>