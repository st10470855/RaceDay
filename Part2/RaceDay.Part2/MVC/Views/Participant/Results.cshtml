@model List<MVC.ViewModels.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold text-primary">My Race Results</h1>
        <p class="text-muted">
            View your finishing times and race positions.
        </p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You do not have any recorded race results yet.
            Once an organiser records your result, it will appear here.
        </div>

        <a asp-controller="Participant"
           asp-action="Events"
           class="btn btn-primary">
            Browse Events
        </a>
    }
    else
    {
        <div class="row g-4">

            @foreach (var result in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body p-4">

                            <span class="badge bg-primary mb-3">
                                Race Result
                            </span>

                            <h4 class="fw-bold">
                                @result.EventName
                            </h4>

                            <hr />

                            <p>
                                <strong>Finishing time:</strong>
                                <span class="text-primary fw-bold">
                                    @result.FinishTime.ToString(@"hh\:mm\:ss")
                                </span>
                            </p>

                            <p>
                                <strong>Finishing position:</strong>
                                @(result.FinishPosition?.ToString() ?? "Not available")
                            </p>

                            <p>
                                <strong>Overall position:</strong>
                                @(result.OverallPosition?.ToString() ?? "Not available")
                            </p>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>
