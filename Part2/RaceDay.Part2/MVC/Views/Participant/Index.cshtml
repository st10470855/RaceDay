@{
    ViewData["Title"] = "Participant Dashboard";
    var firstName = Context.Session.GetString("FirstName") ?? "Participant";
}

<div class="container py-5">

    <div class="p-4 p-md-5 mb-5 bg-primary text-white rounded-3 shadow-sm">
        <h1 class="fw-bold">Welcome, @firstName!</h1>
        <p class="lead mb-3">
            Your next adventure starts here. Discover events,
            manage your entries and track your results.
        </p>

        <a asp-controller="Participant"
           asp-action="Events"
           asp-route-upcomingOnly="true"
           class="btn btn-light text-primary fw-bold">
            Explore Upcoming Events
        </a>
    </div>

    <h3 class="fw-bold mb-4">Your RaceDay Dashboard</h3>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Browse Events</h4>
                    <p class="text-muted">
                        Discover running, walking and cycling events.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="Events"
                       class="btn btn-primary">
                        Browse Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">My Events</h4>
                    <p class="text-muted">
                        View your event registrations and enrolment statuses.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="MyEvents"
                       class="btn btn-primary">
                        My Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">My Results</h4>
                    <p class="text-muted">
                        Track your finishing times and event positions.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="Results"
                       class="btn btn-primary">
                        View Results
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">My Profile</h4>
                    <p class="text-muted">
                        View and update your personal information.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="Profile"
                       class="btn btn-outline-primary">
                        My Profile
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="alert alert-info mt-5">
        <strong>RaceDay Tip:</strong>
        Keep your profile updated so your event registration
        information stays accurate.
    </div>

</div>
