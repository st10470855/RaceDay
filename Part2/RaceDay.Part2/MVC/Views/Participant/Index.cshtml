@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container py-5">

    <div class="mb-5">
        <h1 class="fw-bold text-primary">Welcome to RaceDay!</h1>
        <p class="text-muted">
            Your next adventure starts here. Discover events,
            manage your entries and track your results.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Browse Events</h4>
                    <p class="text-muted">
                        Discover upcoming running, walking and cycling events.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="Events"
                       class="btn btn-primary">
                        Browse Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">My Events</h4>
                    <p class="text-muted">
                        View your event registrations and enrolment statuses.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="MyEvents"
                       class="btn btn-primary">
                        My Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">My Results</h4>
                    <p class="text-muted">
                        Track your finishing times and event positions.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="Results"
                       class="btn btn-primary">
                        View Results
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">My Profile</h4>
                    <p class="text-muted">
                        View and update your personal information.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="Profile"
                       class="btn btn-outline-primary">
                        My Profile
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
