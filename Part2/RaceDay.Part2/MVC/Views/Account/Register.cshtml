@model MVC.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h1 class="fw-bold text-primary">Join RaceDay</h1>
                        <p class="text-muted">
                            Create your account and get ready for your next event.
                        </p>
                    </div> 

                    <div asp-validation-summary="All"
                         class="alert alert-danger"></div>

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        @Html.AntiForgeryToken()

                        <h5 class="mb-3">Personal Information</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">
                                    First Name
                                </label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">
                                    Last Name
                                </label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                Email Address
                            </label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                Password
                            </label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                            <small class="text-muted">
                                Password must contain at least 8 characters.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">
                                Phone Number
                            </label>
                            <input asp-for="Phone" class="form-control" />
                        </div>

                        <hr class="my-4" />

                        <h5 class="mb-3">Account Type</h5>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">
                                I want to register as
                            </label>

                            <select asp-for="Role"
                                    id="roleSelect"
                                    class="form-select">
                                <option value="">Select account type</option>
                                <option value="Participant">Participant</option>
                                <option value="Organizer">Organizer</option>
                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger"></span>
                        </div>

                        <div id="participantFields" style="display:none;">
                            <h5 class="mb-3">Participant Information</h5>

                            <div class="mb-3">
                                <label asp-for="DateOfBirth"
                                       class="form-label">
                                    Date of Birth
                                </label>
                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />
                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Gender" class="form-label">
                                    Gender
                                </label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">Select gender</option>
                                    <option value="Female">Female</option>
                                    <option value="Male">Male</option>
                                    <option value="Other">Other</option>
                                    <option value="Private">
                                        Prefer not to say
                                    </option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Club" class="form-label">
                                    Club (Optional)
                                </label>
                                <input asp-for="Club" class="form-control" />
                            </div>
                        </div>

                        <div id="organizerFields" style="display:none;">
                            <h5 class="mb-3">Organisation Information</h5>

                            <div class="mb-3">
                                <label asp-for="OrganisationName"
                                       class="form-label">
                                    Organisation Name
                                </label>
                                <input asp-for="OrganisationName"
                                       class="form-control" />
                                <span asp-validation-for="OrganisationName"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description"
                                       class="form-label">
                                    Organisation Description
                                </label>
                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="3"></textarea>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Website"
                                       class="form-label">
                                    Website (Optional)
                                </label>
                                <input asp-for="Website"
                                       class="form-control" />
                            </div>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100 py-2 mt-3">
                            Create Account
                        </button>
                    </form>

                    <hr class="my-4" />

                    <p class="text-center mb-0">
                        Already registered?
                        <a asp-controller="Account"
                           asp-action="Login">
                            Sign in here
                        </a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const roleSelect = document.getElementById("roleSelect");
        const participantFields = document.getElementById("participantFields");
        const organizerFields = document.getElementById("organizerFields");

        function updateRoleFields() {
            participantFields.style.display =
                roleSelect.value === "Participant" ? "block" : "none";

            organizerFields.style.display =
                roleSelect.value === "Organizer" ? "block" : "none";
        }

        roleSelect.addEventListener("change", updateRoleFields);
        updateRoleFields();
    </script>
}
